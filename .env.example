# ─────────────────────────────────────────────────────────────────────────────
# Aarudhra Smart Store — environment configuration
# Copy to .env.local for local development (never commit real values).
# On Vercel, add these under Project → Settings → Environment Variables.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only and never reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Aarudhra Smart Store

# ── MongoDB Atlas (required) ─────────────────────────────────────────────────
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=aarudhra_store
# auto = use transactions when the cluster supports them (Atlas always does),
# on = require them, off = use compensation logic instead.
MONGODB_TRANSACTIONS=auto

# ── Sessions (required) ──────────────────────────────────────────────────────
# Each must be a different random string of 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
ADMIN_SESSION_SECRET=

# ── SMS OTP provider (required in production) ────────────────────────────────
# firebase | msg91 | fast2sms | twilio | console   (console = local development only;
# it prints the OTP to the server log and is rejected when NODE_ENV=production)
SMS_PROVIDER=console
# MSG91: SMS_API_KEY = authkey, SMS_TEMPLATE_ID = DLT-approved OTP template id,
#        SMS_SENDER_ID = optional 6-letter sender id
# Fast2SMS: SMS_API_KEY = API key; for the DLT route also set SMS_SENDER_ID and
#        SMS_TEMPLATE_ID (message id); otherwise the "otp" route is used.
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
# Twilio Verify (Twilio generates and checks the code):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Firebase Phone Auth (SMS_PROVIDER=firebase). From Firebase console →
# Project settings → General → Your apps → Web app config. These are public
# identifiers (safe in the browser); no service-account key is needed.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Development only: show the OTP on the login screen when SMS_PROVIDER=console.
# Has no effect in production.
OTP_DEV_MODE=false

# ── WhatsApp Business Platform — Cloud API ───────────────────────────────────
# Permanent System User access token with whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=
# "Phone number ID" (not the phone number) from WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Fallback owner recipient (E.164, e.g. +9198XXXXXXXX). Admin settings take precedence.
WHATSAPP_OWNER_NUMBER=
# Webhook: any random string you also enter in the Meta dashboard.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret (Meta app → Settings → Basic) — used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Approved template names (can also be set in Admin → Settings → Notifications).
WHATSAPP_TEMPLATE_NAME=new_order_alert
WHATSAPP_CUSTOMER_TEMPLATE_NAME=
WHATSAPP_STATUS_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ── Cloudinary (product image uploads) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aarudhra-store

# ── Vercel Cron (notification retries) ───────────────────────────────────────
# Random string; Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
